        "summary": "경기 상세",
        "parameters": [
          {
            "name": "clubId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "경기 상세",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 입력"
          },
          "401": {
            "description": "미인증"
          },
          "403": {
            "description": "CSRF 실패"
          },
          "404": {
            "description": "없는 대상 또는 타인 소유"
