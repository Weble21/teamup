# Copy to .env.docker and replace both passwords with random values.
# DB_PASSWORD must match MYSQL_PASSWORD.
# These values initialize a new MySQL volume; later changes do not alter its accounts.
MYSQL_ROOT_PASSWORD=replace_with_random_root_password
MYSQL_PASSWORD=replace_with_random_app_password
DB_USERNAME=teamup
DB_PASSWORD=replace_with_random_app_password
