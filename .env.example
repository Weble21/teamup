# Copy to .env and replace the placeholder values.
# Spring reads .env as a Java properties file: do not wrap values in quotes.
# Escape literal backslashes as \\. Keep .env out of version control.

# MySQL - use the credentials of your actual local MySQL account.
DB_URL=jdbc:mysql://localhost:3306/teamup
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Social login - enable the oauth profile only after all credentials are ready.
# Uncomment to load application-oauth.properties:
# SPRING_PROFILES_ACTIVE=oauth
APP_BASE_URL=http://localhost:3000

# Kakao: use the REST API key as the client ID.
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# Google: OAuth client credentials for the web application.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Naver: application client credentials.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Optional Claude team analysis. Keep the key on the backend only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
